# MongoDB Atlas connection string (from Atlas → Connect → Drivers).
#
# This should reuse the SAME cluster (same host, same username/password) as
# chromatic-invoice's server — that's what makes the storage "shared" across
# both projects. Just change the database name at the end of the path so
# this project gets its own separate database within that cluster:
#
#   chromatic-invoice's URI ends in  .../chromatic-invoice?retryWrites=...
#   this project's URI should end in .../jensi-electrical-invoice?retryWrites=...
#
# Real value goes in Render's dashboard env vars ONLY — never commit it here.
MONGODB_URI=mongodb+srv://<same-username>:<same-password>@<same-cluster-host>/jensi-electrical-invoice?retryWrites=true&w=majority

# Must match ADMIN_PASSWORD in the frontend's src/config/authConfig.ts
ADMIN_API_KEY=jensi2026

# Your deployed frontend URL, e.g. https://jensi-electrical-invoice.vercel.app
# Use * only while testing locally.
ALLOWED_ORIGIN=https://jensi-electrical-invoice.vercel.app

PORT=4001
